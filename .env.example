# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave service_role: SOMENTE no servidor (Vercel env), nunca exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app (usada em links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamentos: "mock" simula a aprovação. Trocar quando integrar o gateway.
PAYMENTS_MODE=mock
